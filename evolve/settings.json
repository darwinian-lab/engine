{
  "github": {
    "org": "darwinian-lab"
  },
  "species": [
    {
      "id": "qr",
      "repo": "species-qr",
      "domain": "qrsthatlast.com",
      "screenPages": [
        "/",
        "/pricing",
        "/wifi-qr-code-generator"
      ],
      "probes": [
        "free qr code generator that doesn't expire",
        "wifi qr code generator free no sign up",
        "qr code generator without subscription"
      ]
    },
    {
      "id": "resume",
      "repo": "species-resume",
      "domain": "calmcv.com",
      "screenPages": [
        "/",
        "/pricing",
        "/resume-examples"
      ],
      "probes": [
        "free resume builder with free pdf download",
        "resume builder no subscription",
        "software engineer resume example"
      ]
    },
    {
      "id": "wall",
      "repo": "species-wall",
      "domain": "kudospage.com",
      "screenPages": [
        "/",
        "/pricing",
        "/testimonial-widget"
      ],
      "probes": [
        "free testimonial widget for website",
        "how to collect customer testimonials free tool",
        "senja alternative cheaper"
      ]
    }
  ],
  "commands": {
    "claude": [
      "claude",
      "-p",
      "{prompt}",
      "--model",
      "{model}",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read,Edit,Write,Glob,Grep,Bash(npm:*),Bash(npx:*),Bash(node:*),Bash(git status:*),Bash(git diff:*),Bash(git checkout:*),Bash(ls:*),Bash(cat:*)",
      "--output-format",
      "json"
    ],
    "codex": [
      "codex",
      "exec",
      "--skip-git-repo-check",
      "--sandbox",
      "read-only",
      "--output-last-message",
      "{out}",
      "{prompt}"
    ]
  },
  "models": {
    "mutate": "opus",
    "repair": "sonnet"
  },
  "selection": {
    "minTrials": 100,
    "promoteAt": 0.95,
    "killAt": 0.05,
    "maxAgeDays": 21
  },
  "maxSpawnPerRun": 2,
  "timeouts": {
    "mutateMin": 40
  },
  "dryRun": false,
  "reminders": [
    {
      "from": "2027-11-05",
      "text": "The DW_GH_TOKEN GitHub token expires on 2027-11-26. Create a new fine-grained token (darwinian-lab, all repos, Contents/Secrets/Workflows/Actions read & write) and replace the secret on darwinian-lab/engine."
    }
  ]
}
