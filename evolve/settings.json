{
  "github": {
    "org": "darwinian-lab"
  },
  "species": [
    {
      "id": "qr",
      "repo": "species-qr",
      "domain": "qrsthatlast.com",
      "screenPages": [
        "/",
        "/pricing",
        "/wifi-qr-code-generator"
      ],
      "probes": [
        "free qr code generator that doesn't expire",
        "wifi qr code generator free no sign up",
        "qr code generator without subscription"
      ]
    },
    {
      "id": "resume",
      "repo": "species-resume",
      "domain": "calmcv.com",
      "screenPages": [
        "/",
        "/pricing",
        "/resume-examples"
      ],
      "probes": [
        "free resume builder with free pdf download",
        "resume builder no subscription",
        "software engineer resume example"
      ]
    },
    {
      "id": "wall",
      "repo": "species-wall",
      "domain": "kudospage.com",
      "screenPages": [
        "/",
        "/pricing",
        "/testimonial-widget"
      ],
      "probes": [
        "free testimonial widget for website",
        "how to collect customer testimonials free tool",
        "senja alternative cheaper"
      ]
    }
  ],
  "commands": {
    "claude": [
      "claude",
      "-p",
      "{prompt}",
      "--model",
      "{model}",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read,Edit,Write,Glob,Grep,Bash(npm:*),Bash(npx:*),Bash(node:*),Bash(git status:*),Bash(git diff:*),Bash(git checkout:*),Bash(ls:*),Bash(cat:*)",
      "--output-format",
      "json"
    ],
    "codex": [
      "codex",
      "exec",
      "--skip-git-repo-check",
      "--sandbox",
      "read-only",
      "--output-last-message",
      "{out}",
      "{prompt}"
    ]
  },
  "models": {
    "hypothesis": "opus",
    "mutate": "opus",
    "repair": "sonnet",
    "review": "sonnet",
    "address": "sonnet",
    "curate": "sonnet",
    "ideate": "sonnet"
  },
  "selection": {
    "minTrials": 100,
    "minSimsPromote": 10,
    "minPairs": 2,
    "finalistMinSims": 4,
    "finalistMinPairs": 1,
    "regressMargin": 0.05,
    "maxRegress": 0.25,
    "scoreMargin": 3,
    "maxQualityRegress": 0.2,
    "minPairPref": 0.4,
    "killRegress": 0.9,
    "guardDays": 3
  },
  "maxSpawnPerRun": 3,
  "timeouts": {
    "mutateMin": 40,
    "evolveEveryHours": 6,
    "buildMin": 150
  },
  "dryRun": false,
  "reminders": [
    {
      "from": "2027-11-05",
      "text": "The DW_GH_TOKEN GitHub token expires on 2027-11-26. Create a new fine-grained token (darwinian-lab, all repos, Contents/Secrets/Workflows/Actions read & write) and replace the secret on darwinian-lab/engine."
    }
  ],
  "spawnConcurrency": 2,
  "nursery": {
    "simWeight": 1,
    "simFadeAt": 50,
    "minSims": 6,
    "graduateAt": 0.5,
    "fieldSize": 2,
    "nurseryMin": 6,
    "nurseryMax": 12,
    "spawnPerCycle": 3,
    "nurseryMaxDays": 7,
    "fieldMaxDays": 21
  },
  "sims": {
    "enabled": true,
    "inCycle": false,
    "pairShare": 0.3,
    "agent": "codex",
    "model": "haiku",
    "sessionsPerSpecies": 24,
    "concurrency": 4,
    "phaseMinutes": 10,
    "maxTurns": 45,
    "actionsPerPhase": 25,
    "happyAt": 4,
    "browser": "chrome",
    "mobileDevice": "iPhone 15",
    "mcpCommand": "playwright-mcp"
  },
  "growth": {
    "perRun": 4,
    "windowDays": 30,
    "maxProposed": 12,
    "model": "sonnet"
  },
  "crossover": {
    "enabled": true,
    "perCycle": 1,
    "minPBeat": 0.5
  },
  "seeds": {
    "maxDeaths": 3,
    "minScore": 0.12,
    "perCycle": 1
  },
  "backlog": {
    "maxNewPerCycle": 3
  },
  "repairRounds": 3,
  "auditFixRounds": 3,
  "pipeline": "prs",
  "prReviewRounds": 3
}
